# Copia este archivo a .env (en la misma carpeta) y rellena los valores.
# .env NO debe subirse nunca a un repositorio: esta en .gitignore.

# Contrasena de la base de datos PostgreSQL. Cualquier cadena larga sirve.
POSTGRES_PASSWORD=cambia-esta-contrasena

# Clave con la que n8n cifra las credenciales guardadas.
# Generala una sola vez y NO la cambies nunca: si cambia, las credenciales
# ya guardadas dejan de poder descifrarse. Para generarla:
#   openssl rand -base64 32
N8N_ENCRYPTION_KEY=cambia-esta-clave-por-una-aleatoria-larga

# Zona horaria de los disparadores programados (formato IANA).
# Sin esto el contenedor usa UTC. Ejemplos: Europe/Madrid, America/Bogota.
GENERIC_TIMEZONE=Europe/Madrid
