{
 "name": "Libro n8n — Cap 19: informe semanal",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "weeks",
       "weeksInterval": 1,
       "triggerAtDay": [
        1
