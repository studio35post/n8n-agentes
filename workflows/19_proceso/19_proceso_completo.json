{
 "name": "Libro n8n — Cap 19: proceso completo de leads",
 "nodes": [
  {
   "parameters": {
    "path": "lead-formulario",
    "httpMethod": "POST",
    "responseMode": "onReceived",
    "options": {}
   },
   "id": "445c7fac-2c1a-47b4-b765-b5834ef51062",
   "name": "Webhook del formulario",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    160
   ]
  },
  {
   "parameters": {
    "format": "simple",
    "options": {}
   },
   "id": "3492daf6-ead0-4645-88b5-bebdeeaf41bc",
   "name": "Bandeja comercial (IMAP)",
   "type": "n8n-nodes-base.emailReadImap",
   "typeVersion": 2,
   "position": [
    0,
    360
   ]
  },
  {
   "parameters": {},
   "id": "700d9735-2e63-46d9-acc5-7534135cf4ff",
   "name": "Entrada manual",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    560
   ]
  },
  {
   "parameters": {
    "jsCode": "// Normaliza los tres canales al mismo objeto y descarta ruido.\nconst it = $input.first().json;\nlet lead;\nif (it.body) {\n  lead = { remitente: it.body.email, empresa: it.body.empresa ?? '',\n    texto: it.body.mensaje ?? '', canal: 'formulario' };\n} else if (it.from) {\n  lead = { remitente: it.from, empresa: '',\n    texto: `${it.subject}\\n${it.textPlain ?? ''}`, canal: 'correo' };\n} else {\n  lead = { remitente: it.remitente ?? 'manual', empresa: it.empresa ?? '',\n    texto: it.texto ?? '', canal: 'manual' };\n}\nconst ruido = /(unsubscribe|newsletter|no-reply|factura adjunta)/i;\nif (!lead.texto || ruido.test(lead.texto)) return [];\nlead.timestamp = new Date().toISOString();\nlead.clave = `${lead.canal}:${lead.remitente}:${lead.texto.length}`;\nreturn [{ json: lead }];"
   },
   "id": "d7629270-e2ef-43e4-b0e5-c6811b201b7a",
   "name": "Parsing y descarte de no-leads",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    360
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "={{ $json.texto }}",
    "options": {
     "systemMessage": "Clasifica este lead. Responde SOLO JSON valido con: categoria (una de: produccion_video, postproduccion, formacion, otro), confianza (0 a 1) y faltantes (lista de datos que faltan para cualificarlo). Nada mas."
    }
   },
   "id": "e47081bf-1e14-484f-afbb-81b7863007f8",
   "name": "Agente clasificador",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 1.7,
   "position": [
    520,
    360
   ]
  },
  {
   "parameters": {
    "model": "llama3.1:8b",
    "options": {}
   },
   "id": "9c43bba3-9d55-4de5-b69b-9e9e01e79cc9",
   "name": "Modelo local (Ollama)",
   "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
   "typeVersion": 1,
   "position": [
    420,
    580
   ]
  },
  {
   "parameters": {
    "jsCode": "const lead = $('Parsing y descarte de no-leads').first().json;\nconst raw = $input.first().json.output ?? '';\nlet c;\ntry { c = JSON.parse(raw.replace(/```json|```/g, '')); }\ncatch { c = { categoria: 'otro', confianza: 0, faltantes: ['relanzar'] }; }\nreturn [{ json: { ...lead, ...c } }];"
   },
   "id": "b11d9f81-4271-4607-b34d-d76cb1df9521",
   "name": "Validar JSON de clasificacion",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    360
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "leftValue": "={{ $json.confianza }}",
       "rightValue": 0.75,
       "operator": {
        "type": "number",
        "operation": "gte"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "fc37eed7-0547-420c-98fc-6538c91debfd",
   "name": "¿Confianza suficiente?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1020,
    360
   ]
  },
  {
   "parameters": {
    "resource": "message",
    "operation": "post",
    "select": "channel",
    "channelId": {
     "__rl": true,
     "value": "",
     "mode": "list"
    },
    "text": "={{ 'Lead a revisar: ' + $json.remitente + ' — ' + $json.categoria + ' (' + $json.confianza + ')' }}",
    "otherOptions": {}
   },
   "id": "570a667f-8dc3-4c86-88b2-f168d7fb830d",
   "name": "Revision humana (Slack)",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2.2,
   "position": [
    1260,
    500
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "={{ 'Lead: ' + $json.texto + '\\nCategoria: ' + $json.categoria }}",
    "options": {
     "systemMessage": "Redacta la primera respuesta comercial al lead. Tono profesional, maximo 120 palabras, sin placeholders sin rellenar, sin prometer precios ni plazos. Un solo parrafo y una pregunta de cualificacion."
    }
   },
   "id": "0b78aefd-ce5c-4d20-b543-244bdc1d0451",
   "name": "Agente redactor de respuesta",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 1.7,
   "position": [
    1260,
    220
   ]
  },
  {
   "parameters": {
    "model": "llama3.1:8b",
    "options": {}
   },
   "id": "1959f4d8-4442-4e4a-bc6d-f786b73216f6",
   "name": "Modelo local (Ollama)",
   "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
   "typeVersion": 1,
   "position": [
    1160,
    40
   ]
  },
  {
   "parameters": {
    "jsCode": "const lead = $('Validar JSON de clasificacion').first().json;\nconst r = ($input.first().json.output ?? '').trim();\nconst ok = r.length > 40 && r.length < 1200 && !/{{.*}}/.test(r);\nif (!ok) throw new Error('Respuesta no valida: revisar manualmente');\nreturn [{ json: { ...lead, respuesta: r } }];"
   },
   "id": "1dad259b-7632-4faf-bed7-3c97d1d19fd7",
   "name": "Validar respuesta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1500,
    220
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "INSERT INTO leads (clave, remitente, canal, categoria, confianza, respuesta) VALUES ($1, $2, $3, $4, $5, $6) ON CONFLICT (clave) DO NOTHING",
    "options": {
     "queryReplacement": "={{ [$json.clave, $json.remitente, $json.canal, $json.categoria, $json.confianza, $json.respuesta ?? ''] }}"
    }
   },
   "id": "39dc540d-a115-46a2-9738-09b6bd842d58",
   "name": "Registrar lead (idempotente)",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    1740,
    360
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000
  },
  {
   "parameters": {
    "content": "## Las cinco etapas (cap. 19)\nCaptacion (3 canales) → parsing y descarte → clasificacion con JSON validado → respuesta con segundo agente + validacion → registro idempotente. El umbral de confianza (0.75) vive en el IF, no en el prompt. Informe: 19_informe_semanal.json. Esquema: 19_esquema.sql.",
    "width": 500,
    "height": 230
   },
   "id": "28f1acc8-7e4a-42bd-9403-d94ae4b63c67",
   "name": "Nota",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    0
   ]
  }
 ],
