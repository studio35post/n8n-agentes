  {
   "parameters": {
    "jsCode": "// El orquestador es el flujo: valida barato antes de continuar.\nconst item = $input.first().json;\nconst salida = item.output ?? item.text ?? '';\nconst previo = $('Inicializar reintentos').first().json;\nlet valido = salida.length > 10;\nif (previo.tipo === 'factura') {\n  try { const j = JSON.parse(salida); valido = 'total' in j; }\n  catch { valido = false; }\n}\nreturn [{ json: { ...previo, salida, valido,\n  intentos: (previo.intentos ?? 0) + 1 } }];"
   },
   "id": "22c69a50-76b0-4054-90df-edef30e3635d",
   "name": "Validacion entre etapas",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    300
   ]
  },
  {
   "parameters": {
