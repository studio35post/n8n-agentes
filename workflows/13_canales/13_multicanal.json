  {
   "parameters": {
    "jsCode": "const m = $input.first().json.message;\nreturn [{ json: { canal: 'telegram',\n  id_plataforma: String(m.chat.id),\n  session_id: `tg-${m.chat.id}`,\n  texto: m.text ?? '', timestamp: m.date } }];"
   },
   "id": "9cfdc055-e9c6-4354-ace6-629bcdd4693a",
   "name": "Normalizar Telegram",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    200
   ]
  },
  {
   "parameters": {
    "jsCode": "// Cloud API: entry[].changes[].value.messages[]\nconst v = $input.first().json.body.entry?.[0]?.changes?.[0]?.value;\nconst msg = v?.messages?.[0];\nif (!msg) return [];\nreturn [{ json: { canal: 'whatsapp',\n  id_plataforma: msg.from,\n  session_id: `wa-${msg.from}`,\n  texto: msg.text?.body ?? '',\n  timestamp: msg.timestamp } }];"
   },
   "id": "2c904235-b8e0-41d3-bfb4-4c727b792c1e",
   "name": "Normalizar WhatsApp",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    420
   ]
  },
