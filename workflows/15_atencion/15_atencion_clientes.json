{
 "name": "Libro n8n — Cap 15: atencion a clientes multicanal",
 "nodes": [
  {
   "parameters": {
    "path": "atencion-whatsapp",
    "httpMethod": "POST",
    "responseMode": "onReceived",
    "options": {}
   },
   "id": "2809625d-e532-41e5-8709-7bb407f6d97f",
   "name": "Webhook WhatsApp",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    200
   ]
  },
  {
   "parameters": {
    "format": "simple",
    "options": {}
   },
   "id": "a44ebb96-5ed3-47b2-8054-85a3de85bcc0",
   "name": "Correo nuevo (IMAP)",
   "type": "n8n-nodes-base.emailReadImap",
   "typeVersion": 2,
   "position": [
    0,
    420
   ]
  },
  {
   "parameters": {
    "jsCode": "const v = $input.first().json.body.entry?.[0]?.changes?.[0]?.value;\nconst msg = v?.messages?.[0];\nif (!msg) return [];\nreturn [{ json: { canal: 'whatsapp', id_plataforma: msg.from,\n  texto: msg.text?.body ?? '', timestamp: msg.timestamp,\n  adjuntos: [] } }];"
   },
   "id": "18dea351-d6d8-4399-85e3-64ca0912dfe6",
   "name": "Normalizar WhatsApp",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    200
   ]
  },
  {
   "parameters": {
    "jsCode": "const m = $input.first().json;\nreturn [{ json: { canal: 'correo',\n  id_plataforma: (m.from.match(/<(.+)>/) || [null, m.from])[1],\n  texto: `${m.subject}\\n${m.textPlain ?? ''}`,\n  timestamp: Date.now(), adjuntos: [] } }];"
   },
   "id": "6baaa3f6-b5c3-4ae5-90ae-ab4e2e28e9d6",
   "name": "Normalizar correo",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    420
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT cliente_id FROM identidades WHERE canal = $1 AND id_plataforma = $2",
    "options": {
     "queryReplacement": "={{ [$json.canal, $json.id_plataforma] }}"
    }
   },
   "id": "c06b9360-3f31-4235-8f4d-a53b8d7f7ebf",
   "name": "Resolver cliente_id",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    440,
    300
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// {cliente_id, canal, texto, timestamp, caso_id, adjuntos}\nconst entrada = $('Resolver cliente_id').first().json;\nconst previo = $input.first().json;\nconst origen = $('Normalizar WhatsApp').first()?.json ?? $('Normalizar correo').first().json;\nreturn [{ json: { cliente_id: entrada.cliente_id ?? `nuevo-${origen.canal}-${origen.id_plataforma}`,\n  canal: origen.canal, texto: origen.texto,\n  timestamp: origen.timestamp, caso_id: null,\n  adjuntos: origen.adjuntos } }];"
   },
   "id": "556aea3d-164f-4be6-8ec4-0d35e0c3c994",
   "name": "Esquema comun",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    300
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": false,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "leftValue": "={{ $json.texto }}",
       "rightValue": "(queja formal|hablar con una persona|reclamacion|urgente)",
       "operator": {
        "type": "string",
        "operation": "regex"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "fba66985-f087-41e0-967b-ce1deb43aee4",
   "name": "¿Escalada inmediata?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    880,
    300
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "={{ $json.texto }}",
    "options": {
     "systemMessage": "Atencion a clientes sobre el catalogo de producto. Responde SOLO con informacion devuelta por buscar_catalogo. Si la recuperacion no trae resultados relevantes, dilo y ofrece derivar a una persona. No des datos personales de otros clientes."
    }
   },
   "id": "bac60968-cb28-495c-8937-e3fcfab0289d",
   "name": "AI Agent con catalogo",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 1.7,
   "position": [
    1120,
    400
   ]
  },
  {
   "parameters": {
