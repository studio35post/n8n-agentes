   "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
   "typeVersion": 1,
   "position": [
    1000,
    620
   ]
  },
  {
   "parameters": {
    "mode": "retrieve-as-tool",
    "toolName": "buscar_catalogo",
    "toolDescription": "Busca fichas de producto y FAQ (chunking por unidad semantica: una ficha o entrada completa).",
    "qdrantCollection": {
     "__rl": true,
     "value": "catalogo_producto",
     "mode": "id"
    },
    "topK": 4,
    "options": {}
   },
