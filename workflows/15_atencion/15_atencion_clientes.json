   "typeVersion": 1,
   "position": [
    1240,
    800
   ]
  },
  {
   "parameters": {
    "jsCode": "// Escalado con contexto completo (cap. 15): 4 elementos.\nconst caso = $('Esquema comun').first().json;\nreturn [{ json: {\n  mensaje_original: caso.texto,\n  cliente: caso.cliente_id,\n  canal: caso.canal,\n  motivo_escalada: $json.motivo ?? 'disparador inmediato',\n  estado_nuevo: 'escalado_humano' } }];"
   },
   "id": "75075d69-7e67-453d-a7d1-4257763442c4",
   "name": "Paquete de contexto para operador",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1120,
    180
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "INSERT INTO casos (cliente_id, canal, estado, detalle) VALUES ($1, $2, 'escalado_humano', $3)",
    "options": {
     "queryReplacement": "={{ [$json.cliente, $json.canal, JSON.stringify($json)] }}"
    }
   },
   "id": "17c7f1c2-a25c-4243-860c-c8729b991b91",
   "name": "Actualizar caso a escalado",
   "type": "n8n-nodes-base.postgres",
